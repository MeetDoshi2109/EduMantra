# ============================================================
# EduMantra – Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── App ─────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# URL of your deployed app (used for password reset redirect)
APP_URL=http://localhost:3000

# ── Supabase ─────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── JWT ──────────────────────────────────────────────────────
# Used for custom claim signing — use a long random string
JWT_SECRET=change-me-to-a-long-random-secret-string
JWT_EXPIRES_IN=7d

# ── OpenAI ───────────────────────────────────────────────────
# Required for: AI skill gap insights, learning pathway generation,
#               MCQ generation, AI assistant, assessment feedback
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# ── iGOT Karmayogi Integration ───────────────────────────────
# Required for: syncing course catalogue from iGOT platform
# Contact iGOT team for API access: https://igot.gov.in
IGOT_BASE_URL=https://igot.gov.in/apis
IGOT_API_KEY=your-igot-api-key

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# ── Rate Limiting ─────────────────────────────────────────────
# Window in milliseconds (default: 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
# Max requests per window per IP
RATE_LIMIT_MAX=100
